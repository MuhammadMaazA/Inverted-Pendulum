<?xml version="1.0" ?>
<robot name="inverted_pendulum">

  <!-- ========================
       CART BASE (the cart)
  ======================== -->
  <link name="cart">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- A 0.5 x 0.3 x 0.1 box -->
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
      <material name="Blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================
       WHEELS (4) - fixed visuals for appearance
  ======================== -->
  <link name="wheel_fl">
    <visual>
      <origin xyz="0.25 0.18 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
      <material name="Gray"/>
    </visual>
  </link>
  <joint name="wheel_fl_joint" type="fixed">
    <parent link="cart"/>
    <child link="wheel_fl"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wheel_fr">
    <visual>
      <origin xyz="0.25 -0.18 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
      <material name="Gray"/>
    </visual>
  </link>
  <joint name="wheel_fr_joint" type="fixed">
    <parent link="cart"/>
    <child link="wheel_fr"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wheel_rl">
    <visual>
      <origin xyz="-0.25 0.18 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
      <material name="Gray"/>
    </visual>
  </link>
  <joint name="wheel_rl_joint" type="fixed">
    <parent link="cart"/>
    <child link="wheel_rl"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wheel_rr">
    <visual>
      <origin xyz="-0.25 -0.18 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.08"/>
      </geometry>
      <material name="Gray"/>
    </visual>
  </link>
  <joint name="wheel_rr_joint" type="fixed">
    <parent link="cart"/>
    <child link="wheel_rr"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================
       POLE (the inverted pendulum)
       (A tall cylinder plus a sphere on top)
  ======================== -->
  <link name="pole">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <!-- Cylinder portion: length=0.6, radius=0.03, center at z=0.3 -->
    <visual>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.6" radius="0.03"/>
      </geometry>
      <material name="Green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.6" radius="0.03"/>
      </geometry>
    </collision>
    <!-- Sphere bob: radius=0.06, placed with slight overlap at the top (cylinder top is at 0.6) -->
    <visual>
      <origin xyz="0 0 0.57" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.57" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================
       JOINT: Connect the pole to the cart
       (A rigid connection so forces on the pole affect the cart)
  ======================== -->
  <joint name="pole_joint" type="revolute">
    <parent link="cart"/>
    <child link="pole"/>
    <!-- Joint placed at the top center of the cart -->
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <!-- Rotation about the y-axis -->
    <axis xyz="0 1 0"/>
    <limit lower="-0.87266" upper="0.87266" effort="50" velocity="2"/>
  </joint>

</robot>
