<?xml version="1.0" ?>
<robot name="flagpole_decoupled">

  <!-- ========================
       BASE LINK (the cart)
  ======================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.5" iyy="0.5" izz="0.5" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- A 0.4 x 0.2 x 0.05 box -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.05"/>
      </geometry>
      <material name="Blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================
       WHEELS (4, purely visual)
       Each wheel is fixed to the base_link for simplicity
  ======================== -->
  <link name="wheel_1">
    <visual>
      <origin xyz="0.15 0.08 -0.03" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="Gray"/>
    </visual>
  </link>
  <joint name="wheel_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wheel_2">
    <visual>
      <origin xyz="-0.15 0.08 -0.03" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="Gray"/>
    </visual>
  </link>
  <joint name="wheel_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wheel_3">
    <visual>
      <origin xyz="0.15 -0.08 -0.03" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="Gray"/>
    </visual>
  </link>
  <joint name="wheel_3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wheel_4">
    <visual>
      <origin xyz="-0.15 -0.08 -0.03" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="Gray"/>
    </visual>
  </link>
  <joint name="wheel_4_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_4"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================
       ROD LINK (pole + bob)
       Attached via frictionless revolute joint
  ======================== -->
  <link name="rod_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <!-- Cylinder portion -->
    <visual>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <cylinder length="0.5" radius="0.03"/>
      </geometry>
      <material name="Green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.25"/>
      <geometry>
        <cylinder length="0.5" radius="0.03"/>
      </geometry>
    </collision>

    <!-- Sphere bob on top -->
    <visual>
      <origin xyz="0 0 0.53"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.53"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- 
       Revolute joint from base_link to rod_link
       1) Axis is y (pole tilts about y)
       2) friction=0, damping=0 so no torque transmits from rod to cart
  -->
  <joint name="rod_base_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rod_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="0" velocity="0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

</robot>
