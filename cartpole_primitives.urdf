<?xml version="1.0" ?>
<robot name="cartpole_primitives">

  <!-- 
       ========================
         BASE LINK (Cart Body)
       ========================
       A simple box for the cart body
  -->
  <link name="base_link">
    <inertial>
      <!-- Approximate inertial properties -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- A 0.4 x 0.2 x 0.05 box, centered at the link origin -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.05"/>
      </geometry>
      <material name="Blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- 
       ========================
         POLE LINK
       ========================
       A vertical cylinder (length 0.4, radius 0.02).
       We attach it via a revolute joint (pole_base_joint)
       so it can tilt around the y-axis.
  -->
  <link name="pole_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- Center the cylinder around z=0..0.4 in the local frame,
           so the bottom is at z=0 and top is at z=0.4. -->
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.02"/>
      </geometry>
      <material name="Green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.4" radius="0.02"/>
      </geometry>
    </collision>
  </link>

  <!-- 
       ========================
         WHEELS (4 wheels)
       ========================
       Each wheel is a short cylinder. We'll attach
       them with continuous joints around the y-axis.
  -->

  <!-- Top-Left Wheel -->
  <link name="tl_wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- A short cylinder (length=0.02, radius=0.05) -->
      <!-- By default, a cylinder's axis is along z in URDF. -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Bottom-Left Wheel -->
  <link name="bl_wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Top-Right Wheel -->
  <link name="tr_wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Bottom-Right Wheel -->
  <link name="br_wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- 
       ========================
         JOINTS
       ========================
       1) Pole rotates about y-axis (±50° limit).
       2) Wheels rotate continuously about y-axis.
  -->

  <!-- Revolute joint for the pole, tilt about y-axis. -->
  <joint name="pole_base_joint" type="revolute">
    <!-- Position this joint at z=0.05 above the base_link's origin -->
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="pole_1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.87266" upper="0.87266" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- Top-Left Wheel Joint -->
  <joint name="tl_base_joint" type="continuous">
    <!-- Attach at x=0.15, y=0.08, z=0 in base_link frame -->
    <origin xyz="0.15 0.08 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="tl_wheel_1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Bottom-Left Wheel Joint -->
  <joint name="bl_base_joint" type="continuous">
    <origin xyz="-0.15 0.08 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="bl_wheel_1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Top-Right Wheel Joint -->
  <joint name="tr_base_joint" type="continuous">
    <origin xyz="0.15 -0.08 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="tr_wheel_1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Bottom-Right Wheel Joint -->
  <joint name="br_base_joint" type="continuous">
    <origin xyz="-0.15 -0.08 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="br_wheel_1"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
