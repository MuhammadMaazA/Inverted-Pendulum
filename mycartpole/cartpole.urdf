<?xml version="1.0" ?>
<robot name="my_cartpole">

  <!--
    We have:
      link name="rail"      (mass=0, just a reference)
      link name="cart"      (box)
      link name="rod"       (box "standing" as a rod, revolve about y from cart)
      link name="bob"       (sphere, fixed on rod top)
    Joints:
      rail->cart = prismatic along x
      cart->rod  = revolute about y
      rod->bob   = fixed
  -->

  <!-- ========== LINK 0: RAIL (mass=0, invisible) ========== -->
  <link name="rail">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0"/>
      <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <!-- no visual or collision, purely reference -->
  </link>

  <!-- ========== LINK 1: CART (box) ========== -->
  <link name="cart">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0.3 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- prismatic joint along x from rail->cart -->
  <joint name="slider_to_cart" type="prismatic">
    <parent link="rail"/>
    <child  link="cart"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <!-- limit the range to ±10m, for example -->
    <limit effort="1000" lower="-10" upper="10" velocity="5"/>
  </joint>

  <!-- ========== LINK 2: ROD (box standing 0.6m tall, revolve about y) ========== -->
  <link name="rod">
    <inertial>
      <!-- center of mass at half height -->
      <origin xyz="0 0 0.3"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.6"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.3" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.6"/>
      </geometry>
    </collision>
  </link>

  <!-- revolve about y from cart top (z=0.1) to rod bottom( z=0 ) -->
  <joint name="cart_to_rod" type="revolute">
    <parent link="cart"/>
    <child  link="rod"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <!-- limit ±90 deg -->
    <limit effort="100" lower="-1.5708" upper="1.5708" velocity="5"/>
  </joint>

  <!-- ========== LINK 3: BOB (sphere) ========== -->
  <link name="bob">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="yellow">
        <color rgba="0.9 0.9 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- fixed from rod top( z=0.6 ) => bob center( z=0 ) -->
  <joint name="rod_to_bob" type="fixed">
    <parent link="rod"/>
    <child  link="bob"/>
    <origin xyz="0 0 0.6" rpy="0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

</robot>
