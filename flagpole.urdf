<?xml version="1.0" ?>
<robot name="flagpole">

  <!-- ========================
       BASE LINK (Cart)
       ======================== -->
  <link name="base_link">
    <inertial>
      <!-- Heavier cart for stability -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="10.0"/>
      <!-- Larger inertia to reduce unwanted tipping -->
      <inertia ixx="1.0" iyy="1.0" izz="1.0" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- A 0.4 x 0.2 x 0.05 box -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.05"/>
      </geometry>
      <material name="Blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.2 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================
       POLE LINK
       (Taller cylinder + bigger sphere)
       ======================== -->
  <link name="pole_1">
    <inertial>
      <!-- Light pole so it's easier to balance -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.05" iyy="0.05" izz="0.05" ixy="0" ixz="0" iyz="0"/>
    </inertial>

    <!-- The cylinder portion -->
    <visual>
      <!-- Cylinder length=0.5, radius=0.03
           Place its center at z=0.25 so it spans z=0..0.5 from the link origin.
           The pole joint is at z=0.05 from the base, so total top is ~0.55 above ground. -->
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.5" radius="0.03"/>
      </geometry>
      <material name="Green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.25" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.5" radius="0.03"/>
      </geometry>
    </collision>

    <!-- A larger sphere (bob) on top -->
    <visual>
      <!-- The cylinder ends at z=0.5, so place the sphere center at z=0.5 + 0.05=0.55 -->
      <origin xyz="0 0 0.55" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="Silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.55" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================
       WHEELS (4)
       Now oriented vertically by rotating geometry 90°
       so they spin around y-axis (like real wheels).
       ======================== -->

  <link name="tl_wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <!-- By default, a cylinder is aligned along Z.
           We want the cylinder’s axis to be Y for the wheel’s rotation.
           So rotate geometry by +90° around X:
             z-axis => y-axis
       -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
    </collision>
  </link>

  <link name="bl_wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
    </collision>
  </link>

  <link name="tr_wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
    </collision>
  </link>

  <link name="br_wheel_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
      <material name="Gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.06"/>
      </geometry>
    </collision>
  </link>

  <!-- ========================
       JOINTS
       (Pole rotates about y-axis ±50°, wheels rotate about y-axis continuously)
       ======================== -->

  <!-- Pole Joint -->
  <joint name="pole_base_joint" type="revolute">
    <!-- Place the pole at z=0.05 above the cart -->
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="pole_1"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.87266" upper="0.87266" effort="30.0" velocity="2.0"/>
  </joint>

  <!-- 4 Wheel Joints (continuous about y-axis) -->
  <joint name="tl_base_joint" type="continuous">
    <!-- Top-left wheel: x=+0.18, y=+0.10 -->
    <origin xyz="0.18 0.10 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="tl_wheel_1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="bl_base_joint" type="continuous">
    <!-- Bottom-left wheel: x=-0.18, y=+0.10 -->
    <origin xyz="-0.18 0.10 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="bl_wheel_1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="tr_base_joint" type="continuous">
    <!-- Top-right wheel: x=+0.18, y=-0.10 -->
    <origin xyz="0.18 -0.10 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="tr_wheel_1"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="br_base_joint" type="continuous">
    <!-- Bottom-right wheel: x=-0.18, y=-0.10 -->
    <origin xyz="-0.18 -0.10 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="br_wheel_1"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
